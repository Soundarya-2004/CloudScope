# ==========================================================
# CloudScope — Autonomous AWS Cloud Cost Cleanup Agent
# Environment Configuration Template
# ==========================================================

# --- TrueFoundry AI Gateway (Polaris Hackathon) ---
TRUEFOUNDRY_API_KEY=your_truefoundry_api_key_here
TRUEFOUNDRY_BASE_URL=https://gateway.truefoundry.ai
TRUEFORGE_MODEL=vm-polaris/openai

# --- AWS Configuration ---
# Standard AWS credential resolution supports IAM Roles, AWS_PROFILE, or Environment Keys.
# Leave blank to use standard AWS IAM Role or default ~/.aws/credentials
AWS_PROFILE=
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=

# --- Application Security & Encryption ---
# Fernet 32-byte url-safe base64 key used for AES-128-CBC encryption of stored AWS secrets
SECRET_KEY=tIObKkQpUSwX_P4pKYt3rZLC8tZ6JeAUXNKpUtvySRc=

# --- Notifications ---
# Optional verified SES email address for approval notifications
SES_FROM_EMAIL=
APP_BASE_URL=http://localhost:5173

# --- Sandbox Settings ---
SANDBOX_TIMEOUT_SECONDS=25
